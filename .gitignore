# Vendored third-party repositories are tracked, but their generated local
# data, caches, checkpoints, and training outputs are not.
/third_party/**/__pycache__/
/third_party/**/*.pyc
/third_party/**/.ipynb_checkpoints/
/third_party/gaussian-splatting/data/
/third_party/gaussian-splatting/output/
/third_party/gaussian-splatting/outputs/
/third_party/vggt/output/
/third_party/vggt/outputs/
/third_party/**/checkpoints/
/third_party/**/pretrained/
/third_party/**/*.pth
/third_party/**/*.pt
/third_party/**/*.ckpt
/third_party/**/*.ply

# Keep empty project structure in Git.
!data/scenes/**/.gitkeep
!outputs/**/.gitkeep
!data/scenes/*/sparse/
!data/scenes/*/sparse/0/
!data/scenes/*/sparse/0/.gitkeep

