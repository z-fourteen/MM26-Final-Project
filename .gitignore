# 忽略数据集和训练输出模型
gaussian-splatting/data/
gaussian-splatting/output/

# 忽略 Python 缓存和本地临时文件
__pycache__/
*.pyc
.ipynb_checkpoints/
*.ply


# Local migration leftovers / Codex workspace metadata
MM26-Final-Project/
vggt_old_backup/
.agents/
.codex/
*.pdf

# Dataset archives, raw images, generated caches, and large outputs.
/data/raw/
/data/external/
/data/scenes/*/images/*
/data/scenes/*/images_resized/*
/data/scenes/*/features/*
/data/scenes/*/matches/*
/data/scenes/*/verified/*
/data/scenes/*/tracks/*
/data/scenes/*/sparse/*
/data/scenes/*/undistorted/*
/outputs/*
/third_party/

# Keep empty project structure in Git.
!data/scenes/**/.gitkeep
!outputs/**/.gitkeep
!data/scenes/*/sparse/
!data/scenes/*/sparse/0/
!data/scenes/*/sparse/0/.gitkeep
